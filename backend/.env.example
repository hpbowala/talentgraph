# Copy to backend/.env and fill in.
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5-mini
VAULT_SOURCE=local        # local | s3

# ---- AWS deployment ----
# Also read by `cdk deploy` (infrastructure/app.py loads this file).
AWS_REGION=us-east-1
# Bucket names are globally unique — append your account id.
VAULT_BUCKET=talentgraph-data
FRONTEND_BUCKET=talentgraph-frontend
CONVERSATIONS_TABLE=talentgraph-conversations
OPENAI_KEY_PARAM=/talentgraph/openai-api-key

# RETAIN the data bucket, table and user pool on `cdk destroy`. false only for
# throwaway environments — a redeploy under the same names fails otherwise.
RETAIN_DATA=true

# ---- Authentication ----
# Read back from the stack outputs by the Makefile once deployed. With no pool
# configured anywhere the API is ungated, so a fresh checkout runs without AWS.
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Set by CDK inside the AgentCore runtime, not locally:
# VAULT_SOURCE=s3
# CONVERSATION_STORE=dynamodb   # "memory" (local default) | "dynamodb"
