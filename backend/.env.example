# Copy to backend/.env and fill in. Never commit .env.
OPENAI_API_KEY=sk-...
# Optional overrides
OPENAI_MODEL=gpt-5-mini
VAULT_SOURCE=local        # local | s3

# ---- AWS deployment ----------------------------------------------------------
# Read by BOTH the backend and `cdk deploy` (infrastructure/app.py loads this
# file), so resource names are defined once, here.
AWS_REGION=us-east-1
# S3 bucket names are GLOBALLY unique — include something unique to you,
# e.g. your AWS account id.
VAULT_BUCKET=talentgraph-data
FRONTEND_BUCKET=talentgraph-frontend
CONVERSATIONS_TABLE=talentgraph-conversations
# SSM SecureString parameter holding the OpenAI key (create with `make openai-key`)
OPENAI_KEY_PARAM=/talentgraph/openai-api-key

# Keep the CV corpus, chat history and user accounts when the stack is torn
# down or a resource is replaced (the default). Set to false only for a
# throwaway environment you intend to delete whole — with it true, `cdk destroy`
# leaves the data bucket, DynamoDB table and Cognito pool behind, and a later
# deploy under the same names will fail until they are removed by hand.
RETAIN_DATA=true

# ---- Authentication ----------------------------------------------------------
# The Cognito user pool that gates the API. Unlike the names above, these are
# generated by AWS, so they exist only after a pool has been created.
#
# Once `make deploy` has run, the Makefile reads both back from the stack
# outputs automatically and you can leave these blank. Set them to run local
# development against a pool created by hand *before* the first deploy — the
# stack's values win whenever the stack has them.
#
# With no pool configured anywhere the gate is open and the landing page says
# "Open the app" rather than "Sign in", which is what lets a fresh checkout run
# without an AWS account.
# COGNITO_USER_POOL_ID=us-east-1_xxxxxxxxx
# COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
# Set inside the AgentCore runtime by CDK — do not set locally unless testing
# the cloud path:
# VAULT_SOURCE=s3
# CONVERSATION_STORE=dynamodb   # chat history: "memory" (local default) | "dynamodb"
